# Cloudflare Pages response headers (edge config — served with the static
# asset, NOT via a Function/Worker). Static asset requests on Pages are free
# and unlimited and never touch the shared Workers + Pages Functions
# 100k/day quota (enforced structurally by public/_routes.json).
#
# Vite fingerprints everything under /assets with a content hash, so those
# files can be cached in the browser for a year WITHOUT revalidation —
# repeat visits hit the browser cache, and Cloudflare serves them from the
# edge CDN, so almost no requests ever reach an origin.

# Hashed build output: immutable, cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Entry HTML must always be revalidated so every deploy propagates instantly
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker (Web Push) must never be cached — stale SWs block updates
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Static brand assets and sitemap: short cache is fine
/logos/*
  Cache-Control: public, max-age=86400
/STUDYIELD2.png
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=3600
