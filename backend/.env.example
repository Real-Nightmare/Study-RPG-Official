# =====================================================
# STUDY RPG BACKEND CONFIGURATION
# =====================================================
# The docker stack (docker-compose.yml + .env.docker) runs fully local with
# ZERO of the optional credentials below. This file documents every knob;
# copy to .env and change only what you need.
#
# Default posture (owner policy):
#   - AI/email/search/storage all resolve to LOCAL services (Ollama, Mailpit,
#     SearXNG, MinIO) — no accounts, no keys, no credit cards.
#   - Data marketplace: COMPUTE-TO-DATA ONLY and OFF (MARKETPLACE_ENABLED=false).
#   - Billing (Stripe) OFF, FCM OFF — VAPID web push is the push channel.
# =====================================================

# Application
NODE_ENV=development
PORT=3010
API_PREFIX=api/v1
LOG_LEVEL=debug

# Application URLs
APP_URL=http://localhost:3010
FRONTEND_URL=http://localhost:5189
API_URL=http://localhost:3010/api/v1

# =====================================================
# JWT CONFIGURATION
# =====================================================

JWT_ACCESS_SECRET=change-me-in-production-use-openssl-rand-hex-64
JWT_REFRESH_SECRET=change-me-in-production-use-openssl-rand-hex-64
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# =====================================================
# DATABASE (PostgreSQL)
# =====================================================

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=studyrpg_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =====================================================
# REDIS CACHE
# =====================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =====================================================
# QDRANT VECTOR DATABASE
# =====================================================

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=studyrpg

# =====================================================
# CLICKHOUSE ANALYTICS
# =====================================================

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=studyrpg_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# =====================================================
# OBJECT STORAGE  (STORAGE_PROVIDER = minio | r2 | supabase | cloudinary | appwrite)
# minio:      default. Local MinIO from docker-compose; no account needed.
# r2:         opt-in Cloudflare R2 for hosted installs.
# supabase /  free-tier, no-credit-card REST providers (upload/download/
# appwrite:   delete/public URL; S3-only features like listing answer a clear
#             "not supported" error instead of pretending).
# =====================================================

STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=studyrpg-uploads
MINIO_ACCESS_KEY=studyrpg
MINIO_SECRET_KEY=studyrpg-secret
MINIO_PUBLIC_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=study_rpg
R2_PUBLIC_URL=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=studyrpg-uploads
SUPABASE_PUBLIC_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=studyrpg

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=studyrpg-uploads
APPWRITE_PUBLIC_URL=

# =====================================================
# EMAIL  (EMAIL_TRANSPORT = smtp | ses)
# smtp: default. Point MAIL_HOST at Mailpit in docker (mailpit:1025) or any
#       relay. Dev emails are visible at http://localhost:8025.
# ses:  opt-in AWS SES (requires AWS credentials below).
# =====================================================

EMAIL_TRANSPORT=smtp
EMAIL_DEFAULT_FROM=noreply@studyrpg.app
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_CONFIGURATION_SET=

# =====================================================
# AI PROVIDER  (AI_PROVIDER = openai-compatible | openrouter | openai)
# openai-compatible: default. Local Ollama via its OpenAI-compatible API.
#   Start it with `docker compose up -d ollama` then pull models:
#     ollama pull qwen2.5:7b-instruct && ollama pull nomic-embed-text
# openrouter/openai: optional hosted upgrades (keys below).
# =====================================================

AI_PROVIDER=openai-compatible
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:7b-instruct
AI_VISION_MODEL=qwen2.5:7b-instruct

EMBEDDING_PROVIDER=ollama-compatible
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434/v1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Optional hosted upgrades (leave empty to stay fully local)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=

# Reranker (none | openrouter | openai | ollama). Ollama needs no key.
RERANKER_PROVIDER=none
RERANKER_API_URL=http://localhost:11434
RERANKER_MODEL=

# =====================================================
# WEB SEARCH  (SEARCH_PROVIDER = searxng | tavily | serper)
# searxng: default. Local SearXNG container (docker compose up -d searxng).
# =====================================================

SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8888
TAVILY_API_KEY=
SERPER_API_KEY=

# =====================================================
# CODE SANDBOX + ISOLATED COMPUTE-TO-DATA RUNNER
# One hardened sidecar serves both Problem Solver execution and marketplace
# C2D jobs: docker compose up -d c2d-runner
# (network-isolated, read-only fs, non-root, resource-capped)
# =====================================================

CODE_SANDBOX_URL=http://localhost:9000
CODE_SANDBOX_TIMEOUT=30000
C2D_RUNNER_URL=http://localhost:9000
C2D_RUNNER_TIMEOUT_S=30

# =====================================================
# DATA MARKETPLACE — STRICT COMPUTE-TO-DATA ONLY (default OFF)
# While MARKETPLACE_ENABLED=false every /data-marketplace endpoint answers
# 501 and nothing ever leaves the platform (the internal AI benchmark
# pipeline keeps working). When enabled, datasets can only be published as
# on-chain compute assets — there is NO download/access path, PII is
# blocked at field AND value level, and compute jobs never get network access.
# =====================================================

MARKETPLACE_ENABLED=false
MARKETPLACE_PUBLISH_ENABLED=true
MARKETPLACE_MIN_GROUP_SIZE=10
MARKETPLACE_CONSENT_THRESHOLD=0.8
MARKETPLACE_DATASET_LICENSE=CC-BY-4.0 (aggregate statistics only)

# On-chain C2D publishing (Polygon mainnet defaults; wallet funds gas).
OCEAN_NETWORK=mainnet
OCEAN_CHAIN_ID=137
OCEAN_AQUARIUS_URL=
OCEAN_NODE_URL=https://compute1.oceanprotocol.com/
OCEAN_RPC_URL=https://polygon-rpc.com
OCEAN_PUBLISHER_ADDRESS=
OCEAN_PUBLISHER_PRIVATE_KEY=
OCEAN_ERC721_FACTORY=0x6fd867E5AEE6D62a24f97939db90C4e67A73A651
OCEAN_FIXED_RATE_EXCHANGE=0xb28Ab1AaDe4c75F8cF013136fc0c290AeaeA9BA6
OCEAN_TOKEN_ADDRESS=0x282d8efCe846A88B159800bd4130ad77443Fa1A1
OCEAN_C2D_ALLOW_RAW_ALGORITHM=true
OCEAN_C2D_TRUSTED_ALGORITHM_PUBLISERS=

# Idle-capacity Ocean Node — requires BOTH this flag and MARKETPLACE_ENABLED.
OCEAN_NODE_ENABLED=false
OCEAN_NODE_PRIVATE_KEY=
OCEAN_NODE_RPC_URLS={"137":"https://polygon-rpc.com"}

# =====================================================
# BILLING (payments are infrastructure-only, OFF by default)
# With BILLING_ENABLED=false checkout/portal/webhook routes answer 404 and
# plan limits fall back to generous static values.
# =====================================================

BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# =====================================================
# PUSH NOTIFICATIONS
# VAPID web push is the primary channel and is AUTO-CONFIGURED on first boot
# (keys generated and persisted into game_config) — zero setup needed.
# FCM below stays off unless explicitly enabled for Android-native push.
# =====================================================

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@studyrpg.app
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# =====================================================
# RATE LIMITING
# =====================================================

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# =====================================================
# CORS
# =====================================================

CORS_ORIGINS=http://localhost:3010,http://localhost:5189

# =====================================================
# FILE STORAGE (local scratch — object storage is above)
# =====================================================

UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE=10485760
TEMP_FILES_DIR=./temp
