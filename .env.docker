# =====================================================
# STUDY RPG — DOCKER COMPOSE DEFAULTS (fully local)
# =====================================================
# `docker compose --env-file .env.docker up -d` boots the ENTIRE stack with
# no external accounts, API keys or credit cards:
#   postgres redis qdrant clickhouse ollama searxng mailpit minio c2d-runner
#
# Everything below is a safe local default. Optional hosted upgrades
# (OpenRouter, SES, Stripe, Ocean C2D) stay OFF unless you uncomment them.
# =====================================================

# --- Database ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studyrpg_dev
POSTGRES_PORT=5432

# --- Redis -------------------------------------------
REDIS_PORT=6379

# --- Qdrant ------------------------------------------
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- ClickHouse --------------------------------------
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=studyrpg_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Backend / Frontend -------------------------------
BACKEND_PORT=3010
FRONTEND_PORT=5189
JWT_ACCESS_SECRET=change-me-in-production-use-openssl-rand-hex-64
JWT_REFRESH_SECRET=change-me-in-production-use-openssl-rand-hex-64

# --- Local AI (Ollama) --------------------------------
# Models are pulled automatically by the ollama-init service on first boot.
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Local web search (SearXNG) -----------------------
SEARXNG_PORT=8888

# --- Local email sink (Mailpit) -----------------------
# Read dev emails at http://localhost:${MAILPIT_UI_PORT}
MAILPIT_UI_PORT=8025

# --- Local object storage (MinIO) ---------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=studyrpg
MINIO_ROOT_PASSWORD=studyrpg-secret
MINIO_BUCKET=studyrpg-uploads

# --- Strictly-off-by-default surfaces ------------------
# Data marketplace is COMPUTE-TO-DATA ONLY; while false, every marketplace
# endpoint answers 501 and nothing ever leaves the platform.
MARKETPLACE_ENABLED=false
BILLING_ENABLED=false
FCM_ENABLED=false

# --- Optional hosted upgrades (all off by default) -----
# AI upgrade: OPENROUTER_API_KEY=sk-or-v1-...
# Email via AWS SES: EMAIL_TRANSPORT=ses + AWS credentials in backend/.env
# On-chain compute-to-data publishing (requires funded Polygon wallet):
#   MARKETPLACE_ENABLED=true
#   OCEAN_PUBLISHER_PRIVATE_KEY=0x...
#   OCEAN_PUBLISHER_ADDRESS=0x...
